<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_2"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    
    <TextView style="@style/StudyDateDialogTitle"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm" />

    
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="@string/ui_dialog_confirm_delete_text_2"
        android:textColor="@color/brown"
        android:textSize="@dimen/_12ssp" />

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView style="@style/StudyDateDialogActionSecondary"
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_marginEnd="@dimen/_10sdp"
            android:text="@string/cancel" />

        <TextView style="@style/StudyDateDialogActionPrimary"
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:text="@string/option_delete" />
    </LinearLayout>

</LinearLayout>
