<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_edittext"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <TextView
        android:id="@+id/tvUserName"
        style="@style/StudyDateDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvUserDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/input_text"
        android:textSize="@dimen/_12ssp" />

    <TextView
        android:id="@+id/btnAccountStatus"
        style="@style/StudyDateDialogActionPrimary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_16sdp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutAccountStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/etAccountReason"
            android:text="@string/admin_reason"
            android:textColor="@color/brown" />

        <EditText
            android:id="@+id/etAccountReason"
            style="@style/StudyDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="top|start"
            android:hint="@string/admin_reason_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:labelFor="@id/etReportId"
            android:text="@string/admin_report_id"
            android:textColor="@color/brown" />

        <EditText
            android:id="@+id/etReportId"
            style="@style/StudyDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/admin_report_id_hint"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvAccountStatusError"
            style="@style/StudyDateErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancelAccountStatus"
                style="@style/StudyDateDialogActionSecondary"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/cancel" />

            <TextView
                android:id="@+id/btnConfirmAccountStatus"
                style="@style/StudyDateDialogActionPrimary"
                android:layout_width="wrap_content"
                android:text="@string/confirm" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnClose"
        style="@style/StudyDateDialogActionSecondary"
        android:layout_width="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/_16sdp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/btn_close" />
</LinearLayout>
