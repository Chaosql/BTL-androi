<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_2"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    
    <TextView style="@style/StudyDateDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_dialog_add_subject_text_1" />

    <EditText style="@style/StudyDateInput"
        android:id="@+id/etSubjectName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:hint="@string/ui_dialog_add_subject_hint_2"
        android:inputType="text"
        android:paddingHorizontal="@dimen/_12sdp"
        android:textSize="@dimen/_12ssp" />

    <TextView style="@style/StudyDateErrorText"
        android:id="@+id/tvSubjectError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:accessibilityLiveRegion="polite"
        android:textSize="@dimen/_12ssp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="@string/ui_dialog_add_subject_text_3"
        android:textColor="@color/brown"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgSubjectType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_16sdp"
            android:checked="true"
            android:text="@string/ui_dialog_add_subject_text_4"
            android:textColor="@color/brown"
            android:textSize="@dimen/_12ssp" />

        <RadioButton
            android:id="@+id/rbReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_dialog_add_subject_text_5"
            android:textColor="@color/brown"
            android:textSize="@dimen/_12ssp" />
    </RadioGroup>

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView style="@style/StudyDateDialogActionSecondary"
            android:id="@+id/btnCancelAdd"
            android:layout_width="wrap_content"
            android:layout_marginEnd="@dimen/_10sdp"
            android:text="@string/cancel" />

        <TextView style="@style/StudyDateDialogActionPrimary"
            android:id="@+id/btnConfirmAdd"
            android:layout_width="wrap_content"
            android:text="@string/confirm" />
    </LinearLayout>

</LinearLayout>
