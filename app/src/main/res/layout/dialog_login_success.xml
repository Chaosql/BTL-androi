<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/_20sdp"
    app:cardBackgroundColor="@color/bg_2"
    app:cardCornerRadius="@dimen/_24sdp"
    app:cardElevation="@dimen/_6sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_24sdp">

        
        <FrameLayout
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:background="@drawable/bg_circle_success_halo"
            android:layout_marginTop="@dimen/_8sdp"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivSuccessCheck"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_success_check"
                android:contentDescription="Success" />
        </FrameLayout>

        
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/ui_dialog_login_success_text_1"
            android:textColor="@color/brown"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold"
            android:gravity="center" />

        
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/login_success_message"
            android:textColor="@color/hint"
            android:textSize="@dimen/_12ssp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

        
        <ProgressBar
            android:id="@+id/pbLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/_140sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:indeterminate="true"
            android:indeterminateTint="@color/orange"
            android:progressTint="@color/brown" />

        
        <TextView
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:background="@drawable/bg_button"
            android:gravity="center"
            android:text="@string/ui_dialog_login_success_text_2"
            android:textColor="@color/brown"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
