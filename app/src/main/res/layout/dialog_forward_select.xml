<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_2"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/ui_dialog_forward_select_text_1"
        android:textColor="@color/brown"
        android:textSize="@dimen/_16ssp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/bg_edittext"
        android:backgroundTint="@null"
        android:hint="@string/ui_dialog_forward_select_hint_2"
        android:inputType="text"
        android:paddingHorizontal="@dimen/_12sdp"
        android:textColor="@color/input_text"
        android:textColorHint="@color/hint"
        android:textSize="@dimen/_12ssp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConversations"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="@dimen/_12sdp" />

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_36sdp"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/bg_card_retro"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_18sdp"
        android:text="@string/cancel"
        android:textColor="@color/brown"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold" />

</LinearLayout>
