<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <TextView style="@style/StudyDateDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_dialog_edit_personal_info_text_1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_4sdp"
                android:orientation="vertical">

                <EditText style="@style/StudyDateInput"
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:hint="@string/hint_last_name"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_12ssp" />

                <TextView style="@style/StudyDateErrorText"
                    android:id="@+id/tvErrorLastName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_4sdp"
                android:orientation="vertical">

                <EditText style="@style/StudyDateInput"
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:hint="@string/hint_first_name"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_12ssp" />

                <TextView style="@style/StudyDateErrorText"
                    android:id="@+id/tvErrorFirstName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/ui_dialog_edit_personal_info_text_2"
            android:textColor="@color/brown"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <EditText style="@style/StudyDateInput"
            android:id="@+id/etDateOfBirth"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:hint="@string/hint_birth_date"
            android:inputType="date"
            android:paddingHorizontal="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp" />

        <TextView style="@style/StudyDateErrorText"
            android:id="@+id/tvErrorDateOfBirth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/sex"
            android:textColor="@color/brown"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_12sdp"
                android:text="@string/ui_dialog_edit_personal_info_text_4"
                android:textColor="@color/brown"
                android:textSize="@dimen/_11ssp" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_12sdp"
                android:text="@string/ui_dialog_edit_personal_info_text_5"
                android:textColor="@color/brown"
                android:textSize="@dimen/_11ssp" />

            <RadioButton
                android:id="@+id/rbOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_dialog_edit_personal_info_text_6"
                android:textColor="@color/brown"
                android:textSize="@dimen/_11ssp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/school"
            android:textColor="@color/brown"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <EditText style="@style/StudyDateInput"
            android:id="@+id/etUniversity"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:hint="@string/ui_dialog_edit_personal_info_hint_8"
            android:inputType="text"
            android:paddingHorizontal="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp" />

        <TextView style="@style/StudyDateErrorText"
            android:id="@+id/tvErrorUniversity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/major"
            android:textColor="@color/brown"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <EditText style="@style/StudyDateInput"
            android:id="@+id/etMajorName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:hint="@string/ui_dialog_edit_personal_info_hint_10"
            android:inputType="text"
            android:paddingHorizontal="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp" />

        <TextView style="@style/StudyDateErrorText"
            android:id="@+id/tvErrorMajorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/ui_dialog_edit_personal_info_text_11"
            android:textColor="@color/brown"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <EditText style="@style/StudyDateInput"
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:hint="@string/ui_dialog_edit_personal_info_hint_12"
            android:inputType="phone"
            android:paddingHorizontal="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/ui_dialog_edit_personal_info_text_13"
            android:textColor="@color/brown"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <EditText style="@style/StudyDateInput"
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:hint="@string/ui_dialog_edit_personal_info_hint_14"
            android:inputType="text"
            android:paddingHorizontal="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView style="@style/StudyDateDialogActionSecondary"
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_marginEnd="@dimen/_10sdp"
                android:text="@string/cancel" />

            <TextView style="@style/StudyDateDialogActionPrimary"
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:text="@string/ui_dialog_edit_introduction_text_4" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
