<?xml version="1.0" encoding="utf-8"?>
<LinearLayout style="@style/StudyDatePopupContainer" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout style="@style/StudyDatePopupRow"
        android:id="@+id/btnMenuNewChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_plus"
            app:tint="@color/brown" />

        <TextView style="@style/StudyDatePopupLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_layout_friends_menu_popup_text_1" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hint" />

    <LinearLayout style="@style/StudyDatePopupRow"
        android:id="@+id/btnMenuPendingRequests"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_notification"
            app:tint="@color/brown" />

        <TextView style="@style/StudyDatePopupLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_fragment_pending_requests_text_1" />
    </LinearLayout>

</LinearLayout>
