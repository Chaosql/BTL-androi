<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_2"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <TextView style="@style/StudyDateDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_dialog_cancel_reason_text_1" />

    <EditText style="@style/StudyDateInput"
        android:id="@+id/etCancelReason"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="top|start"
        android:hint="@string/ui_dialog_cancel_reason_hint_2"
        android:inputType="textMultiLine"
        android:padding="@dimen/_10sdp"
        android:textSize="@dimen/_12ssp" />

    <TextView
        android:id="@+id/tvCancelError"
        style="@style/StudyDateErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityLiveRegion="polite" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="#F4F0CA"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_16sdp"
            android:text="@string/back"
            android:textColor="@color/brown"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmCancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_36sdp"
            android:background="@drawable/bg_button"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_16sdp"
            android:text="@string/btn_cancel"
            android:textColor="@color/brown"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
