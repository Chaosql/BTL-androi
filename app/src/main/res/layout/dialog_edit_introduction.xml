<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_2"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    
    <TextView style="@style/StudyDateDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_dialog_edit_introduction_text_1" />

    <EditText style="@style/StudyDateInput"
        android:id="@+id/etStatusTag"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="top|start"
        android:hint="@string/ui_dialog_edit_introduction_hint_2"
        android:inputType="textMultiLine"
        android:padding="@dimen/_12sdp"
        android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvFormError"
            style="@style/StudyDateErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite" />


    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView style="@style/StudyDateDialogActionSecondary"
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_marginEnd="@dimen/_10sdp"
            android:text="@string/cancel" />

        <TextView style="@style/StudyDateDialogActionPrimary"
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:text="@string/ui_dialog_edit_introduction_text_4" />
    </LinearLayout>

</LinearLayout>
