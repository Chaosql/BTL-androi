<resources>
    <style name="StudyDateInput" parent="">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>
    <style name="StudyDateErrorText" parent="">
        <item name="android:textColor">@color/error</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="StudyDateDialogTitle" parent="">
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StudyDateDialogAction" parent="">
        <item name="android:layout_height">@dimen/_36sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/_18sdp</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StudyDateDialogActionPrimary" parent="StudyDateDialogAction">
        <item name="android:background">@drawable/bg_button</item>
    </style>
    <style name="StudyDateDialogActionSecondary" parent="StudyDateDialogAction">
        <item name="android:background">@drawable/bg_card_retro</item>
    </style>
    <style name="StudyDatePopupContainer" parent="">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:elevation">@dimen/_8sdp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/_6sdp</item>
    </style>
    <style name="StudyDatePopupRow" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/_12sdp</item>
        <item name="android:paddingVertical">@dimen/_10sdp</item>
    </style>
    <style name="StudyDatePopupLabel" parent="">
        <item name="android:layout_marginStart">@dimen/_10sdp</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
